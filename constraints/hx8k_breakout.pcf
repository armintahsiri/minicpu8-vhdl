# Lattice iCE40-HX8K Breakout Board, iCE40HX8K-CT256, nominal 12 MHz.
# Pin references: Lattice FPGA-EB-02031 user guide / vendor demo design.
# Every assignment remains UNVERIFIED on hardware. Reset, UART-TX and switch
# wiring have not been checked on a physical board.
set_io clk      J3  # UNVERIFIED on hardware; vendor guide identifies clock input
set_io rst_n    K11 # UNVERIFIED on hardware; proposed external active-low reset
set_io uart_tx  B12 # UNVERIFIED on hardware; vendor schematic FTDI receive path

set_io led[0]   B5  # UNVERIFIED on hardware
set_io led[1]   B4  # UNVERIFIED on hardware
set_io led[2]   A2  # UNVERIFIED on hardware
set_io led[3]   A1  # UNVERIFIED on hardware
set_io led[4]   C5  # UNVERIFIED on hardware
set_io led[5]   C4  # UNVERIFIED on hardware
set_io led[6]   B3  # UNVERIFIED on hardware
set_io led[7]   C3  # UNVERIFIED on hardware

set_io sw[0]    G15 # UNVERIFIED on hardware; external switch/jumper input
set_io sw[1]    G16 # UNVERIFIED on hardware; external switch/jumper input
set_io sw[2]    F15 # UNVERIFIED on hardware; external switch/jumper input
set_io sw[3]    R14 # UNVERIFIED on hardware; external switch/jumper input
set_io sw[4]    R15 # UNVERIFIED on hardware; external switch/jumper input
set_io sw[5]    H16 # UNVERIFIED on hardware; external switch/jumper input
set_io sw[6]    R16 # UNVERIFIED on hardware; external switch/jumper input
set_io sw[7]    T14 # UNVERIFIED on hardware; external switch/jumper input
